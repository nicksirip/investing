# Configurable moving average study with directional coloring.
# Includes optional (hidden by default) crossover direction signal.

input maType = AverageType.SIMPLE;
input maLength = 50;
input priceType = {default Close, Open, High, Low, HL2, HLC3, OHLC4};
input upColor = Color.GREEN;
input downColor = Color.RED;
input flatColor = Color.GRAY;

def selectedPrice;
switch (priceType) {
case Close:
    selectedPrice = close;
case Open:
    selectedPrice = open;
case High:
    selectedPrice = high;
case Low:
    selectedPrice = low;
case HL2:
    selectedPrice = (high + low) / 2;
case HLC3:
    selectedPrice = (high + low + close) / 3;
case OHLC4:
    selectedPrice = (open + high + low + close) / 4;
}

plot MovingAvg = MovingAverage(maType, selectedPrice, maLength);
MovingAvg.AssignValueColor(
    if MovingAvg > MovingAvg[1] then upColor
    else if MovingAvg < MovingAvg[1] then downColor
    else flatColor
);
MovingAvg.SetPaintingStrategy(PaintingStrategy.LINE);
MovingAvg.SetLineWeight(2);
MovingAvg.HideBubble();

plot CrossDirection =
    if selectedPrice crosses above MovingAvg then 1
    else if selectedPrice crosses below MovingAvg then -1
    else Double.NaN;
CrossDirection.AssignValueColor(
    if CrossDirection > 0 then upColor
    else if CrossDirection < 0 then downColor
    else flatColor
);
CrossDirection.SetPaintingStrategy(PaintingStrategy.HISTOGRAM);
CrossDirection.SetLineWeight(3);
CrossDirection.HideBubble();
CrossDirection.Hide();
